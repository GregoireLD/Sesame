    "onboarding.permissions.note" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند طلب الوصول إلى الموقع، اختر \"السماح دائمًا\" للحصول على أفضل تجربة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du nach dem Standortzugriff gefragt wirst, wähle „Immer erlauben\" für das beste Erlebnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When asked for location access, choose \"Always Allow\" for the best experience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando te pidan acceso a la ubicación, elige \"Permitir siempre\" para la mejor experiencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu'on vous demande l'accès à la localisation, choisissez \"Toujours autoriser\" pour la meilleure expérience."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ti viene richiesto l'accesso alla posizione, scegli \"Consenti sempre\" per la migliore esperienza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報のアクセスを求められたら、最高のエクスペリエンスのために「常に許可」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 접근 권한을 요청받으면 최상의 경험을 위해 \"항상 허용\"을 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
