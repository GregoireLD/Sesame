    "key.recovery.reset_confirm.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف جميع إدخالاتك ومفتاح التشفير بشكل دائم على جميع أجهزتك. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle deine Einträge und dein Verschlüsselungsschlüssel dauerhaft auf allen deinen Geräten gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete all your entries and your encryption key across all your devices. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente todas tus entradas y tu clave de cifrado en todos tus dispositivos. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera définitivement toutes vos entrées et votre clé de chiffrement sur tous vos appareils. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo eliminerà definitivamente tutte le voci e la chiave di crittografia su tutti i tuoi dispositivi. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデバイスのすべてのエントリと暗号化キーが完全に削除されます。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 기기에서 모든 항목과 암호화 키가 영구적으로 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除您所有设备上的所有条目和加密密钥。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將永久刪除您所有裝置上的所有條目和加密金鑰。此操作無法撤銷。"
          }
        }
      }
    },
    "key.recovery.reset_confirm.title" : {
