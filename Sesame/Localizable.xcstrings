    "qr.warning" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي رمز QR هذا على جميع الحقول المشتركة بنص واضح. شاركه فقط مع أشخاص موثوقين. استخدم AirDrop للنقل الآمن بين الأجهزة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser QR-Code enthält alle freigegebenen Felder im Klartext. Teile ihn nur mit vertrauenswürdigen Personen. Verwende AirDrop für eine sichere Übertragung zwischen Geräten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This QR code contains all the shared fields in plain text. Only share it with trusted people. Use AirDrop for secure device-to-device transfer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código QR contiene todos los campos compartidos en texto plano. Compártelo solo con personas de confianza. Usa AirDrop para transferencias seguras entre dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce QR code contient tous les champs partagés en clair. Ne le partagez qu'avec des personnes de confiance. Utilisez AirDrop pour un transfert sécurisé entre appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo codice QR contiene tutti i campi condivisi in testo normale. Condividilo solo con persone di fiducia. Usa AirDrop per trasferimenti sicuri tra dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このQRコードには共有されたすべての項目が平文で含まれています。信頼できる人とのみ共有してください。デバイス間の安全な転送にはAirDropを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 QR 코드에는 공유된 모든 항목이 일반 텍스트로 포함되어 있습니다. 신뢰할 수 있는 사람과만 공유하세요. 기기 간 안전한 전송에는 AirDrop을 사용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 QR 码以明文形式包含所有共享字段。请仅与可信任的人分享。使用 AirDrop 进行安全的设备间传输。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 QR 碼以明文形式包含所有共享欄位。請僅與可信任的人分享。使用 AirDrop 進行安全的裝置間傳輸。"
          }
        }
      }
    },
