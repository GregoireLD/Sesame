    "about.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخزّن Sesame رموز الدخول إلى مبانيك ويُخطرك تلقائيًا عند وصولك إلى موقع محفوظ — لن تحتاج بعد الآن للبحث عن رمز في هاتفك أمام الباب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame speichert deine Zugangscodes und benachrichtigt dich automatisch, wenn du einen gespeicherten Ort erreichst — nie wieder auf der Suche nach einem Code vor der Tür."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame stores your building access codes and automatically notifies you when you arrive at a saved location — so you never have to dig through your phone to find a code at the door."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame almacena tus códigos de acceso y te notifica automáticamente al llegar a una ubicación guardada — nunca más buscarás un código en tu teléfono frente a la puerta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame stocke vos codes d'accès et vous notifie automatiquement lorsque vous arrivez à un emplacement enregistré — plus besoin de chercher un code dans votre téléphone devant la porte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame memorizza i tuoi codici di accesso e ti notifica automaticamente quando arrivi in un luogo salvato — niente più ricerche frenetiche sul telefono davanti alla porta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesameは建物のアクセスコードを保存し、登録した場所に到着すると自動で通知します。もうドアの前でコードを探す必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame은 건물 출입 코드를 저장하고 저장된 위치에 도착하면 자동으로 알려줍니다 — 문 앞에서 코드를 찾느라 헤맬 필요가 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame 存储您的楼宇门禁代码，并在您到达已保存位置时自动通知您——再也不用在门口翻找代码了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame 儲存您的大樓門禁代碼，並在您抵達已儲存位置時自動通知您——再也不用在門口翻找代碼了。"
          }
        }
      }
    },
