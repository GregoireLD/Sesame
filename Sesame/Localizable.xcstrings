    "about.privacy_statement" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تشفير جميع البيانات الحساسة على جهازك قبل المزامنة. لا يمكن لأحد قراءة رموز الدخول الخاصة بك، بما في ذلك Apple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle sensiblen Daten werden auf deinem Gerät verschlüsselt, bevor sie synchronisiert werden. Deine Zugangscodes sind für niemanden lesbar, einschließlich Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All sensitive data is encrypted on your device before syncing. Your access codes are never readable by anyone, including Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los datos sensibles se cifran en tu dispositivo antes de sincronizarse. Tus códigos de acceso nunca son legibles por nadie, ni siquiera por Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les données sensibles sont chiffrées sur votre appareil avant synchronisation. Vos codes d'accès ne sont lisibles par personne, pas même Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i dati sensibili vengono crittografati sul tuo dispositivo prima della sincronizzazione. I tuoi codici di accesso non sono mai leggibili da nessuno, nemmeno da Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての機密データは同期前にデバイス上で暗号化されます。アクセスコードはAppleを含む誰にも読み取れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 민감한 데이터는 동기화 전에 기기에서 암호화됩니다. Apple을 포함한 누구도 귀하의 출입 코드를 읽을 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有敏感数据在同步前均已在您的设备上加密。包括 Apple 在内，任何人都无法读取您的门禁代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有敏感資料在同步前均已在您的裝置上加密。包括 Apple 在內，任何人都無法讀取您的門禁代碼。"
          }
        }
      }
    },
