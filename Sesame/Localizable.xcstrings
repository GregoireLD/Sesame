    "duplicate.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد إدخال بنفس الاسم والعنوان. قد يكون هذا إدخالاً مكرراً أو نسخةً محدَّثة."
