    "key.recovery.reset_footer" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم هذا الخيار فقط إذا استمرت المشكلة وأردت البدء من جديد. سيؤدي هذا إلى حذف جميع الإدخالات على جميع أجهزتك بشكل دائم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur verwenden, wenn das Problem anhält und du neu beginnen möchtest. Dadurch werden alle Einträge auf all deinen Geräten dauerhaft gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only use this if the problem persists and you want to start fresh. This will permanently delete all entries on all your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsalo solo si el problema persiste y quieres empezar de cero. Esto eliminará permanentemente todas las entradas en todos tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À utiliser uniquement si le problème persiste et que vous souhaitez repartir de zéro. Cela supprimera définitivement toutes les entrées sur tous vos appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usalo solo se il problema persiste e vuoi ricominciare da capo. Questo eliminerà definitivamente tutte le voci su tutti i tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題が解決しない場合にのみ使用してください。すべてのデバイスのすべてのエントリが完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제가 지속되고 새로 시작하려는 경우에만 사용하세요. 모든 기기의 모든 항목이 영구적으로 삭제됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在问题持续存在且您想重新开始时使用。这将永久删除所有设备上的所有条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在問題持續存在且您想重新開始時使用。這將永久刪除所有裝置上的所有條目。"
          }
        }
      }
    },
    "key.recovery.settings_footer" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من تفعيل iCloud Keychain عبر الإعدادات ← Apple ID ← iCloud ← كلمات المرور والمفاتيح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass iCloud-Schlüsselbund aktiviert ist unter Einstellungen → Apple-ID → iCloud → Passwörter & Schlüsselbund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure iCloud Keychain is enabled under Settings → Apple ID → iCloud → Passwords & Keychain."
          }
        },
        "es" : {
