    "clipboard.overwrite.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي الاستيراد من الحافظة إلى استبدال كل ما أدخلته. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Import aus der Zwischenablage ersetzt alles, was du eingegeben hast. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importing from clipboard will replace everything you've entered. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importar desde el portapapeles reemplazará todo lo que has introducido. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'import depuis le presse-papiers remplacera tout ce que vous avez saisi. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'importazione dagli appunti sostituirà tutto ciò che hai inserito. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボードからインポートすると、入力したすべての内容が置き換えられます。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립보드에서 가져오면 입력한 모든 내용이 교체됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从剪贴板导入将替换您输入的所有内容。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從剪貼簿匯入將取代您輸入的所有內容。此操作無法撤銷。"
          }
        }
      }
