    "permission.location.banner" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى الموقع في الخلفية مطلوب لعمل الإشعارات عند إغلاق التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standortzugriff im Hintergrund ist erforderlich, damit Benachrichtigungen funktionieren, wenn die App geschlossen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background location access is required for notifications to work when the app is closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere acceso a la ubicación en segundo plano para que las notificaciones funcionen cuando la app está cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la localisation en arrière-plan est nécessaire pour recevoir les notifications lorsque l'application est fermée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso alla posizione in background è necessario per far funzionare le notifiche quando l'app è chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが閉じているときに通知を機能させるには、バックグラウンドの位置情報アクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 닫혀 있을 때 알림이 작동하려면 백그라운드 위치 접근 권한이 필요합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
