    "onboarding.permissions.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Sesame إلى موقعك والإشعارات لتنبيهك عند وصولك. بدون هذه الأذونات، يمكن للتطبيق تخزين رموزك بأمان — لكنه لن يتمكن من إخطارك تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame benötigt Zugriff auf deinen Standort und Benachrichtigungen, um dich bei der Ankunft zu informieren. Ohne diese Berechtigungen kann die App deine Codes weiterhin sicher speichern — kann dich aber nicht automatisch benachrichtigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame needs access to your location and notifications to alert you when you arrive at a saved address. Without these, the app can still store your codes safely — but won't be able to notify you automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame necesita acceso a tu ubicación y notificaciones para alertarte al llegar. Sin estos permisos, la app puede seguir almacenando tus códigos de forma segura — pero no podrá notificarte automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame a besoin de votre localisation et des notifications pour vous alerter à l'arrivée. Sans ces autorisations, l'application peut toujours stocker vos codes en sécurité — mais ne pourra pas vous notifier automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame ha bisogno dell'accesso alla tua posizione e alle notifiche per avvisarti all'arrivo. Senza questi permessi, l'app può comunque archiviare i tuoi codici in modo sicuro — ma non potrà notificarti automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesameは登録した住所に到着したときにアラートするために、位置情報と通知へのアクセスが必要です。これらがなくてもコードを安全に保存できますが、自動通知はできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame이 저장된 주소에 도착했을 때 알림을 보내려면 위치 및 알림 접근 권한이 필요합니다. 이 없이도 코드를 안전하게 저장할 수 있지만 자동 알림은 불가능합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame 需要访问您的位置和通知权限，以便在您到达已保存地址时提醒您。没有这些权限，应用仍可安全存储您的代码——但无法自动通知您。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame 需要存取您的位置和通知權限，以便在您抵達已儲存地址時提醒您。沒有這些權限，應用程式仍可安全儲存您的代碼——但無法自動通知您。"
          }
        }
      }
    },
    "onboarding.permissions.title" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذنان ضروريان"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Berechtigungen"
          }
