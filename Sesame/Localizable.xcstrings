    "onboarding.security.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لك iOS قفل أي تطبيق مباشرةً من شاشتك الرئيسية، مما يوفر طبقة حماية إضافية لرموز الدخول الخاصة بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ermöglicht es dir, jede App direkt vom Startbildschirm zu sperren und so eine zusätzliche Schutzebene für deine Zugangscodes hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS lets you lock any app directly from your home screen, adding an extra layer of protection for your access codes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS te permite bloquear cualquier app directamente desde tu pantalla de inicio, añadiendo una capa extra de protección para tus códigos de acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS vous permet de verrouiller n'importe quelle application depuis votre écran d'accueil, ajoutant une couche de protection supplémentaire pour vos codes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ti consente di bloccare qualsiasi app direttamente dalla schermata Home, aggiungendo un ulteriore livello di protezione per i tuoi codici di accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSではホーム画面から直接アプリをロックでき、アクセスコードの保護をさらに強化できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS를 사용하면 홈 화면에서 직접 앱을 잠글 수 있어 출입 코드에 추가 보호 레이어를 제공합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 允许您直接从主屏幕锁定任何应用，为您的门禁代码增加额外的保护层。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 允許您直接從主畫面鎖定任何應用程式，為您的門禁代碼增加額外的保護層。"
          }
        }
      }
    },
