    "onboarding.welcome.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رموز دخول مبانيك، دائمًا في متناول يدك — وتُعرض تلقائيًا عند حاجتك إليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Zugangscodes, immer zur Hand — und automatisch angezeigt, wenn du sie brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your building access codes, always at hand — and delivered to you automatically when you need them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus códigos de acceso, siempre a mano — y entregados automáticamente cuando los necesitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos codes d'accès, toujours à portée de main — et affichés automatiquement quand vous en avez besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi codici di accesso, sempre a portata di mano — e consegnati automaticamente quando ne hai bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建物のアクセスコードをいつでも手元に — 必要なときに自動的に届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건물 출입 코드를 항상 손끝에 — 필요할 때 자동으로 전달됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
