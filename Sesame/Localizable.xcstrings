    "This will show the key unavailable banner as if iCloud Keychain had failed. The app will re-check periodically." : {
      "comment" : "A message displayed in an alert within the \"Simulate broken key\" button in the \"About\" view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُظهر هذا شريط تحذير المفتاح كما لو فشل iCloud Keychain. سيعيد التطبيق الفحص تلقائياً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies zeigt das Banner für einen fehlenden Schlüssel an, als ob iCloud Keychain fehlgeschlagen wäre. Die App prüft automatisch erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will show the key unavailable banner as if iCloud Keychain had failed. The app will re-check periodically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto mostrará el banner de clave no disponible como si el llavero de iCloud hubiera fallado. La app volverá a comprobarlo periódicamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela affichera la bannière de clé indisponible comme si le trousseau iCloud avait échoué. L'app revérifiera automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrerà il banner della chiave non disponibile come se il portachiavi iCloud avesse avuto un errore. L'app controllerà nuovamente automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudキーチェーンが失敗したかのようにキー利用不可バナーを表示します。アプリは自動的に再確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 키체인이 실패한 것처럼 키 사용 불가 배너를 표시합니다. 앱이 자동으로 다시 확인합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将显示密钥不可用横幅，就像 iCloud 钥匙串发生故障一样。应用将自动重新检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將顯示金鑰不可用橫幅，就像 iCloud 鑰匙圈發生故障一樣。應用程式將自動重新檢查。"
          }
        }
      }
    },
    "Wait" : {
      "comment" : "The text on a button that dismisses an alert when pressed.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
