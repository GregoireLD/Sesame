        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt bereits einen Eintrag mit demselben Namen und derselben Adresse. Er könnte ein Duplikat oder eine aktualisierte Version sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
