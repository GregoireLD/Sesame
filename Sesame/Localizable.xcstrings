{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (%@)" : {
      "comment" : "The app version and build number displayed in the footer of the about screen. The first argument is the string “CFBundleShortVersionString” or the string “—”. The second argument is the string “CFBundleVersion” or the string “—”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "about.credits" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Made with ♥ in Paris"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait avec ♥ à Paris"
          }
        }
      }
    },
    "about.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame stores your building access codes and automatically notifies you when you arrive at a saved location — so you never have to dig through your phone to find a code at the door."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesame stocke vos codes d'accès et vous notifie automatiquement lorsque vous arrivez à un emplacement enregistré — plus besoin de chercher un code dans votre téléphone devant la porte."
          }
        }
      }
    },
    "about.privacy_header" : {
      "localizations" : {
