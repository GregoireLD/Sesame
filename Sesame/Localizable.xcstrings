    "address.warning.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الإدخال ليس له موقع محلول. لن يعمل السياج الجغرافي حتى تقوم بتعديله والبحث عن عنوان صالح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Eintrag hat keinen aufgelösten Standort. Geofencing funktioniert erst, wenn du ihn bearbeitest und eine gültige Adresse auflöst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This entry has no resolved location. Geofencing won't work until you edit it and look up a valid address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta entrada no tiene ubicación resuelta. El geofencing no funcionará hasta que la edites y busques una dirección válida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette entrée n'a pas de localisation résolue. Le géofencing ne fonctionnera pas jusqu'à ce que vous la modifiiez et résolviez une adresse valide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa voce non ha una posizione risolta. Il geofencing non funzionerà finché non la modifichi e cerchi un indirizzo valido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエントリには解決済みの位置情報がありません。編集して有効な住所を検索するまでジオフェンシングは機能しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목에는 확인된 위치가 없습니다. 편집하여 유효한 주소를 찾을 때까지 지오펜싱이 작동하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此条目没有已解析的位置。在您编辑并查找有效地址之前，地理围栏将无法工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此條目沒有已解析的位置。在您編輯並查找有效地址之前，地理圍欄將無法工作。"
