    "error.key_unavailable.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح التشفير الخاص بك غير متوفر بعد. تأكد من تفعيل iCloud Keychain في الإعدادات وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Verschlüsselungsschlüssel ist noch nicht verfügbar. Stelle sicher, dass iCloud-Schlüsselbund in den Einstellungen aktiviert ist, und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your encryption key is not available yet. Make sure iCloud Keychain is enabled in Settings and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de cifrado aún no está disponible. Asegúrate de que el llavero de iCloud esté activado en Ajustes e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé de chiffrement n'est pas encore disponible. Assurez-vous que le trousseau iCloud est activé dans les Réglages et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua chiave di crittografia non è ancora disponibile. Assicurati che il portachiavi iCloud sia attivato nelle Impostazioni e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化キーがまだ利用できません。設定でiCloudキーチェーンが有効になっていることを確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화 키를 아직 사용할 수 없습니다. 설정에서 iCloud 키체인이 활성화되어 있는지 확인하고 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的加密密钥尚不可用。请确保在设置中启用了 iCloud 钥匙串，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
